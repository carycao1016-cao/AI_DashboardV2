# 本机后端 AI 开关。复制为 backend/.env 后修改；该实际文件已被 Git 忽略。
# 密钥和方舟推理接入点继续仅填写在 parser_poc/.env.ark。
PARSER_AI_ENABLED=false
PARSER_AI_PROFILE=deepseek
# 前台小批量测试保持为 1；上传本身不会调用模型。
PARSER_AI_MAX_SHEETS=1
# 大 Sheet 的轻量 Outline 分块上限。较小请求可降低方舟单次超时概率。
PARSER_AI_OUTLINE_TARGET_TOKENS=24000
PARSER_AI_OUTLINE_HARD_TOKENS=28000
